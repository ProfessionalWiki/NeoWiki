{
	"$schema": "https://json-schema.org/draft/2020-12/schema#",
	"type": "object",
	"$defs": {
		"severity": {
			"enum": [ "error", "warning" ]
		},
		"booleanConstraint": {
			"if": { "type": "object" },
			"then": {
				"required": [ "severity" ],
				"additionalProperties": false,
				"properties": { "severity": { "$ref": "#/$defs/severity" } }
			},
			"else": { "type": "boolean" }
		},
		"booleanConstraintWithFalseValue": {
			"if": { "type": "object" },
			"then": {
				"required": [ "value", "severity" ],
				"additionalProperties": false,
				"properties": {
					"value": { "const": false },
					"severity": { "$ref": "#/$defs/severity" }
				}
			},
			"else": { "type": "boolean" }
		},
		"scalarConstraint": {
			"if": { "type": "object" },
			"then": {
				"required": [ "value", "severity" ],
				"additionalProperties": false,
				"properties": {
					"value": true,
					"severity": { "$ref": "#/$defs/severity" }
				}
			}
		},
		"datePrecisionConstraint": {
			"if": { "type": "object" },
			"then": {
				"required": [ "value", "severity" ],
				"additionalProperties": false,
				"properties": {
					"value": { "enum": [ "month", "day" ] },
					"severity": { "$ref": "#/$defs/severity" }
				}
			},
			"else": { "enum": [ "month", "day", null ] }
		},
		"dateBoundConstraint": {
			"if": { "type": "object" },
			"then": {
				"required": [ "value", "severity" ],
				"additionalProperties": false,
				"properties": {
					"value": { "type": "string" },
					"severity": { "$ref": "#/$defs/severity" }
				}
			},
			"else": { "type": [ "string", "null" ] }
		},
		"customConstraint": {
			"if": {
				"type": "object",
				"required": [ "severity" ]
			},
			"then": {
				"properties": { "severity": { "$ref": "#/$defs/severity" } }
			}
		}
	},
	"properties": {
		"description": {
			"type": "string"
		},
		"propertyDefinitions": {
			"type": "object",
			"patternProperties": {
				"^.*$": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/customConstraint" },
					"required": [
						"type"
					],
					"properties": {
						"description": {
							"type": "string"
						},
						"type": {
							"type": "string",
							"minLength": 1
						},
						"default": true,
						"required": { "$ref": "#/$defs/booleanConstraint" },
						"multiple": { "$ref": "#/$defs/booleanConstraintWithFalseValue" },
						"uniqueItems": { "$ref": "#/$defs/booleanConstraint" },
						"minimum": { "$ref": "#/$defs/scalarConstraint" },
						"maximum": { "$ref": "#/$defs/scalarConstraint" },
						"minLength": { "$ref": "#/$defs/scalarConstraint" },
						"maxLength": { "$ref": "#/$defs/scalarConstraint" },
						"options": { "$ref": "#/$defs/scalarConstraint" }
					},
					"allOf": [
						{
							"if": {
								"required": [
									"type"
								],
								"properties": {
									"type": {
										"const": "date"
									}
								}
							},
							"then": {
								"properties": {
									"minimum": { "$ref": "#/$defs/dateBoundConstraint" },
									"maximum": { "$ref": "#/$defs/dateBoundConstraint" },
									"minPrecision": { "$ref": "#/$defs/datePrecisionConstraint" }
								}
							}
						},
						{
							"if": {
								"required": [
									"type"
								],
								"properties": {
									"type": {
										"const": "relation"
									}
								}
							},
							"then": {
								"required": [
									"relation",
									"targetSchema"
								],
								"properties": {
									"relation": {
										"type": "string",
										"pattern": "^\\S(.*\\S)?$",
										"$error": "The relation type must not be empty or have surrounding whitespace."
									},
									"targetSchema": {
										"oneOf": [
											{
												"type": "string",
												"pattern": "^\\S(.*\\S)?$"
											},
											{
												"type": "object",
												"required": [
													"source",
													"name"
												],
												"properties": {
													"source": {
														"type": "string",
														"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
													},
													"name": {
														"type": "string",
														"pattern": "^\\S(.*\\S)?$"
													}
												},
												"additionalProperties": false
											}
										],
										"$error": "The target schema must be a Schema name, or an object with a source key and a name. Neither may be empty or have surrounding whitespace."
									}
								}
							}
						}
					]
				}
			}
		}
	},
	"required": [
		"propertyDefinitions"
	],
	"additionalProperties": true
}
