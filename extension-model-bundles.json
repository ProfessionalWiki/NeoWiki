{
	"name": "NeoWikiModelBundles",
	"author": [
		"[https://Professional.Wiki/ Professional Wiki]",
		"[https://www.EntropyWins.wtf/mediawiki Jeroen De Dauw]",
		"Morne Alberts",
		"[https://www.mediawiki.org/wiki/User:Alistair3149 Alistair3149]",
		"[https://github.com/ProfessionalWiki/NeoWiki/graphs/contributors?all=1 ...]"
	],
	"url": "https://neowiki.ai/docs/api/model-bundles",
	"license-name": "GPL-2.0-or-later",
	"descriptionmsg": "neowiki-model-bundles-description",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"extensions": {
			"NeoWiki": "*"
		}
	},
	"MessagesDirs": {
		"NeoWikiModelBundles": [
			"i18n/modelBundles"
		]
	},
	"ExtensionMessagesFiles": {
		"NeoWikiModelBundlesAliases": "i18n/modelBundles/_Aliases.php"
	},
	"SpecialPages": {
		"DataModel": "ProfessionalWiki\\NeoWiki\\ModelBundles\\SpecialDataModel"
	},
	"Hooks": {
		"NeoWikiGetFrontendModules": "ModelBundlesOverviewNoticeHook"
	},
	"HookHandlers": {
		"ModelBundlesOverviewNoticeHook": {
			"class": "ProfessionalWiki\\NeoWiki\\ModelBundles\\OverviewNoticeHook"
		}
	},
	"attributes": {
		"NeoWiki": {
			"OverviewLinks": [
				{
					"page": "Special:DataModel",
					"label": "neowiki-special-datamodel",
					"description": "neowiki-overview-datamodel-description"
				}
			]
		}
	},
	"config": {
		"NeoWikiModelBundleCatalogs": {
			"description": "The URLs of the catalogs of model bundles that Special:DataModel installs from. The browser reads them, so their servers have to let other websites read them (CORS). See https://neowiki.ai/docs/api/model-bundles#catalogs",
			"value": []
		},
		"NeoWikiModelBundlePreselection": {
			"description": "The names of the catalog entries that the data model setup selects by default.",
			"value": []
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "NeoWiki"
	},
	"ResourceModules": {
		"ext.neowiki.modelBundles": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"dependencies": [
				"ext.neowiki",
				"vue",
				"pinia",
				"mediawiki.api",
				"mediawiki.util",
				"mediawiki.storage"
			],
			"packageFiles": [
				"resources/ext.neowiki/dist/modelBundles.js",
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconCollapse",
						"cdxIconDownload",
						"cdxIconExpand",
						"cdxIconPuzzle",
						"cdxIconUpload"
					]
				}
			],
			"styles": [
				"resources/ext.neowiki/dist/modelBundles.css"
			],
			"codexComponents": [
				"CdxButton",
				"CdxCard",
				"CdxCheckbox",
				"CdxField",
				"CdxIcon",
				"CdxMessage",
				"CdxProgressBar",
				"CdxRadio",
				"CdxTextArea",
				"CdxTextInput",
				"CdxToggleSwitch"
			],
